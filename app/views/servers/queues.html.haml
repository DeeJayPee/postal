- page_title << @server.name
- page_title << "Messages"
- page_title << "Queues"
= render 'sidebar', :active_server => @server
= render 'header', :active_nav => :messages
= render 'messages/header', :active_nav => :queues

.pageContent
  %p.pageContent__intro.u-margin
    This page shows runtime queue state for this server only.

  - if current_user.admin?
    %p.pageContent__text.u-margin
      Queue configuration and backoff rules are global.
      = link_to "Manage global queue configuration", admin_queues_path, :class => "u-link"

  - if @queue_names.empty?
    .noData.noData--clean
      %h2.noData__title No virtual queues found for this server.
      %p.noData__text
        Send traffic through this server to populate queue runtime metrics.
  - else
    .u-margin
      %h2.pageContent__subTitle Queue runtime status
      %table.dataTable.u-margin-half
        %thead
          %tr
            %td Queue
            %td Total
            %td Ready
            %td Delayed
            %td Locked
            %td Max Attempts
            %td Oldest
            %td Next Retry
        %tbody
          - @queue_names.each do |queue_name|
            - total = @queue_totals[queue_name].to_i
            - delayed = @queue_delayed[queue_name].to_i
            - locked = @queue_locked[queue_name].to_i
            - ready = [total - delayed, 0].max
            - oldest = @queue_oldest[queue_name]
            - next_retry = @queue_next_retry[queue_name]
            - max_attempts = @queue_max_attempts[queue_name]
            %tr
              %td= queue_name
              %td= number_with_delimiter(total)
              %td= number_with_delimiter(ready)
              %td= number_with_delimiter(delayed)
              %td= number_with_delimiter(locked)
              %td= max_attempts || "-"
              %td= oldest ? oldest.to_fs(:short) : "-"
              %td= next_retry ? next_retry.to_fs(:short) : "-"
