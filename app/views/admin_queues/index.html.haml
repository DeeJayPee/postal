- page_title << "Admin"
- page_title << "Global Queues"

.pageHeader
  %h1.pageHeader__title Global Queues

.pageContent
  %p.pageContent__intro.u-margin
    Runtime queue sizes, global queue configuration, MX rollups, backoff rules, and SMTP diagnostics across all organizations and servers.

  %dl.adminStats.u-margin
    .adminStats__stat
      %dt Global queue size
      %dd= number_with_delimiter(@global_queue_size)
    .adminStats__stat
      %dt Ready now
      %dd= number_with_delimiter(@global_runtime[:ready])
    .adminStats__stat
      %dt Scheduled
      %dd= number_with_delimiter(@global_runtime[:scheduled])
    .adminStats__stat
      %dt Sending / locked
      %dd= number_with_delimiter(@global_runtime[:locked])
    .adminStats__stat
      %dt In rollups / queues
      %dd= number_with_delimiter(@known_queue_size)
    .adminStats__stat
      %dt Rest
      %dd= number_with_delimiter(@rest_queue_size)

  %p.pageContent__text.u-margin
    “Rest” contains every queued message whose virtual queue is blank, disabled, or no longer matches an enabled queue, MX rollup, or domain macro.
    Counts are a snapshot from
    = succeed "." do
      %strong= @queue_snapshot_at.to_fs(:long)
    = link_to "Refresh now", admin_queues_path, class: "u-link"
    Rest currently has
    = succeed " ready," do
      %strong= number_with_delimiter(@rest_runtime[:ready])
    = succeed " scheduled, and" do
      %strong= number_with_delimiter(@rest_runtime[:scheduled])
    = succeed " locked." do
      %strong= number_with_delimiter(@rest_runtime[:locked])

  .buttonSet.u-margin
    = button_to "Refresh pending queue assignments",
                admin_refresh_queue_assignments_path(after_id: @reclassify_after),
                method: :post,
                class: "button button--small button--dark",
                data: { confirm: "Resolve current recipient MX records and reclassify up to 1,000 pending messages?" }

  .u-margin#queue-configurations
    %h2.pageContent__subTitle Queue configurations
    - if @queue_configs.empty?
      %p.pageContent__text No enabled queue configurations found.
    - else
      %table.dataTable.u-margin-half
        %thead
          %tr
            %td Queue
            %td Total
            %td Ready
            %td Scheduled
            %td Locked
            %td Next attempt
            %td Mode
            %td Max Msg Rate
            %td SMTP Out
            %td Max Rcpt
            %td Backoff Relay
            %td Backoff Delay
            %td Auto Return
            %td Action
        %tbody
          - @queue_configs.each do |config|
            - runtime = @queue_runtime.fetch(config.queue_name)
            - auto_return = "manual"
            - if config.backoff_auto_success_threshold.present? && config.backoff_auto_success_window_seconds.present?
              - auto_return = "#{config.backoff_auto_success_threshold} in #{distance_of_time_in_words(Time.current, Time.current + config.backoff_auto_success_window_seconds)}"
            %tr
              %td= config.queue_name
              %td= number_with_delimiter(runtime[:total])
              %td= number_with_delimiter(runtime[:ready])
              %td= number_with_delimiter(runtime[:scheduled])
              %td= number_with_delimiter(runtime[:locked])
              %td= runtime[:next_attempt_at] ? runtime[:next_attempt_at].to_fs(:short) : "-"
              %td= config.mode
              %td= config.max_msg_rate || "-"
              %td= "#{config.min_smtp_out}-#{config.max_smtp_out}"
              %td= config.max_rcpt_per_message || "-"
              %td= config.backoff_reroute_to || "-"
              %td
                - if config.backoff_base_delay_seconds.present?
                  = distance_of_time_in_words(Time.current, Time.current + config.backoff_base_delay_seconds)
                - else
                  = "-"
              %td= auto_return
              %td
                .buttonSet
                  = link_to "Edit", admin_edit_queue_path(config), class: "button button--small"
                  - target_mode = config.backoff? ? "normal" : "backoff"
                  - label = config.backoff? ? "Set normal" : "Set backoff"
                  = button_to label,
                              admin_set_queue_mode_path(queue_name: config.queue_name, mode: target_mode),
                              method: :post,
                              class: ["button", "button--small", (config.backoff? ? "button--positive" : "button--danger")]
                  = button_to "Retry now",
                              admin_retry_queue_path(queue_name: config.queue_name),
                              method: :post,
                              class: "button button--small button--dark",
                              data: { confirm: "Make every unlocked message in #{config.queue_name} eligible for the next worker run?" }

  .row.row--2col.u-margin
    .col.col--10.col--collapse
      %h2.pageContent__subTitle Add a queue
      = render "queue_form",
               queue_configuration: @new_queue,
               form_url: admin_create_queue_path,
               submit_label: "Add queue",
               queue_name_editable: true

    .col.col--10.col--collapse
      %h2.pageContent__subTitle Add an MX rollup
      = render "rollup_form",
               mx_rollup: @new_rollup,
               queue_configs: @queue_configs,
               form_url: admin_create_rollup_path,
               submit_label: "Add MX rollup"

  .u-margin#mx-rollups
    %h2.pageContent__subTitle MX rollup mappings
    - if @rollups.empty?
      %p.pageContent__text No enabled MX rollups found.
    - else
      %table.dataTable.u-margin-half
        %thead
          %tr
            %td MX hostname
            %td Queue / rollup
            %td Description
            %td Action
        %tbody
          - @rollups.each do |rollup|
            %tr
              %td= rollup.mx_hostname
              %td= rollup.rollup_name
              %td= rollup.description.presence || "-"
              %td= link_to "Edit", admin_edit_rollup_path(rollup), class: "button button--small"

  .u-margin
    %h2.pageContent__subTitle Deliver a real diagnostic email
    %p.pageContent__text.u-margin-half
      Sends a real email, including DATA, from this Postal host using the selected queue's normal route or its backoff relay.
      The complete SMTP response is displayed. A successful delivery returns a backoff queue to normal mode.
    = form_with url: admin_smtp_probe_path, scope: :smtp_probe, local: true do |f|
      %fieldset.fieldSet.fieldSet--compact.u-margin-half
        .fieldSet__fieldPair
          .fieldSet__field
            = f.label :recipient, "Recipient to test", class: "fieldSet__label"
            .fieldSet__input= f.email_field :recipient, value: @smtp_probe_values[:recipient], class: "input input--text", placeholder: "user@example.net", required: true
          .fieldSet__field
            = f.label :queue_name, "Queue", class: "fieldSet__label"
            .fieldSet__input
              = f.select :queue_name,
                         options_for_select(@queue_configs.map { |queue| [queue.queue_name, queue.queue_name] }, @smtp_probe_values[:queue_name]),
                         { include_blank: "Select a queue" },
                         class: "input input--select",
                         required: true
        .fieldSet__field
          = f.label :mail_from, "MAIL FROM", class: "fieldSet__label"
          .fieldSet__input= f.email_field :mail_from, value: @smtp_probe_values[:mail_from], class: "input input--text", placeholder: "sender@example.com", required: true
      = f.submit "Send diagnostic email", class: "button button--dark", data: { confirm: "This sends a real email to the recipient. Continue?" }

    - if @smtp_probe_result
      .u-margin
        - probe_result_class = @smtp_probe_result.recipient_accepted ? "u-green u-bold" : (@smtp_probe_result.connected ? "u-orange u-bold" : "u-red u-bold")
        %p{class: probe_result_class}= @smtp_probe_result.summary
        - if @smtp_probe_result.endpoint
          %p.pageContent__text= "Endpoint: #{@smtp_probe_result.endpoint}"
        - if @smtp_probe_recovered_queue
          %p.u-green.u-bold= "#{@smtp_probe_recovered_queue} returned to normal mode after the successful delivery."
        %pre.codeBlock.codeBlock--whitespace= @smtp_probe_result.transcript

  .u-margin
    %h2.pageContent__subTitle Loaded global backoff rules
    - if @backoff_rules.empty?
      %p.pageContent__text No backoff rules loaded.
    - else
      %table.dataTable.u-margin-half
        %thead
          %tr
            %td Action
            %td Pattern
            %td Source List
        %tbody
          - @backoff_rules.each do |rule|
            %tr
              %td= rule.action
              %td= "/#{rule.pattern}/"
              %td= rule.description.presence || "-"
